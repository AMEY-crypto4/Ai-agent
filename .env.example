# Required: your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: model to use for generation (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: cap on tokens per single generation response (defaults to 8192).
# This limits the size of one reply, not how many requests a user can make.
# There is no built-in request quota, rate limit, or per-user usage cap in
# this app — usage is bounded only by your own Anthropic account/API limits.
MAX_OUTPUT_TOKENS=8192

# Optional: port for the web server (defaults to 3000)
PORT=3000
